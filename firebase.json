{
  "hosting": [
    {
      "target": "sales",
      "public": "dist",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "indexes": "firestore.indexes.json"
  }
}
